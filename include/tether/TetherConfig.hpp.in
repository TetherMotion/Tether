#pragma once

/**
 * @file TetherConfig.hpp
 * @brief Auto-generated configuration header for Tether library
 *
 * This file is auto-generated by CMake (configure_file()) or by the ESP-IDF
 * component build. Do not edit directly and DO NOT COMMIT the generated
 * output — it is a build artifact that reflects the options of one specific
 * configure run. It lives in the build tree, not the source tree.
 *
 * Every flag is wrapped in #ifndef so that a compile definition
 * (-DTETHER_ENABLE_X=...) from the build system always wins over the
 * generated default. Flags are always defined to 0 or 1 — test them with
 * '#if TETHER_ENABLE_X', never '#ifdef' (the macro is always defined).
 */

#define TETHER_VERSION_MAJOR @Tether_VERSION_MAJOR@
#define TETHER_VERSION_MINOR @Tether_VERSION_MINOR@
#define TETHER_VERSION_PATCH @Tether_VERSION_PATCH@
#define TETHER_VERSION "@Tether_VERSION@"

