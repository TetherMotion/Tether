// Tether <print> polyfill shim.
//
// This header is ONLY put on the include path when the compiler's standard
// library does not ship a native <print> header (e.g. GCC < 15, which has
// <format> since GCC 13 but not <print>). It is found via CMake's
// `include_directories(BEFORE ...)` so that `#include <print>` resolves here
// instead of the (missing) system header.
//
// It re-exports the {fmt} library's print/println APIs into namespace std,
// so existing code using std::print / std::println compiles unchanged.
// {fmt} is the library that std::format/std::print was based on, so the
// behaviour is equivalent for the subset used by Tether and ESC211.
//
// When the toolchain provides a real <print> (GCC >= 15, recent clang/MSVC),
// CMake does NOT add this directory to the include path and the standard
// <print> is used directly.
//
// NOTE: This shim depends on the <format> shim (or native <format>) being
// active, because fmt::print uses fmt::format_string which is the same type
// re-exported as std::format_string by the <format> shim. When the native
// <format> is available but <print> is not (e.g. GCC 13/14), we still need
// to include {fmt} to get fmt::print — the CMake logic handles this by
// activating the {fmt} submodule whenever either shim is needed.
#pragma once

#include <fmt/base.h>    // fmt::print, fmt::println

// Ensure std::format_string etc. are available (from the <format> shim or
// native <format>). This is needed because fmt::print's format_string<T...>
// is a different type than std::format_string when both native <format> and
// the {fmt} shim are active. However, in practice when this <print> shim is
// active, either:
//   (a) the <format> shim is also active (GCC < 13) — fmt::format_string is
//       re-exported as std::format_string, so they're the same type, or
//   (b) native <format> is available but <print> is not (GCC 13/14) — in
//       this case fmt::print accepts fmt::format_string which is constructed
//       from the same compile-time format string, so call sites like
//       std::print("{}", x) resolve to fmt::print(fmt::format_string("{}"), x)
//       which works correctly.
//
// The key insight: std::print("literal", args...) in our code expands to
// fmt::print("literal", args...) via the using-declaration below, and
// fmt::print constructs its own fmt::format_string from the literal — it
// does not require a std::format_string. So the using-declaration is safe.

namespace std {

using fmt::print;
using fmt::println;

} // namespace std
